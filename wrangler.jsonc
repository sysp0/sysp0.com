{
  // Static site on Cloudflare Workers: `npm run build` writes plain files to ./out,
  // and `wrangler deploy` uploads them as static assets. No server, no OpenNext.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sysp0-com",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  // Required by `wrangler preview`, which Workers Builds runs for PR branches.
  "previews": {}
}
